{
	"manifest_version": 3,
	"name": "Serious About Work",
	"version": "0.0.1",
	"description": "Blocks distractions and tracks the time of each session.",
	"background": {
		"service_worker": "service-worker.js",
		"type": "module"
	},
	"permissions": [
		"storage",
		"alarms",
		"declarativeNetRequest"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"web_accessible_resources": [
		{
			"resources": [
				"blocked.html"
			],
			"matches": [
				"<all_urls>"
			]
		}
	],
	"action": {
		"default_title": "Serious About Work",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	}
}
